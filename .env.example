# Sewa Setu Configuration
# Copy to .env and adjust for your environment

# Public base URL stamped into OAuth tokens and discovery documents
PUBLIC_BASE_URL=http://localhost:8000

# Departmental administrative / officer credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploying

# Database credentials
POSTGRES_DB=sewasetu
POSTGRES_USER=sewasetu
POSTGRES_PASSWORD=sewasetu123
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Secret key for Flask session
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Trusted block assignments for departmental officers (JSON mapping)
OFFICER_BLOCK_MAPPINGS={"admin": "Sonari", "officer_sonari": "Sonari", "officer_namti": "Namti"}

# Live-Model Evaluations (optional: leaves evals in deterministic scripted regression mode if unset)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

